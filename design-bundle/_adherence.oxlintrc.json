      {
        "selector": "JSXOpeningElement[name.name='Milestone'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|key|ref|className|style|children)$/]",
        "message": "<Milestone> doesn't accept that prop. Declared props: label, icon."
      }
    ]
