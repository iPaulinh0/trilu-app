# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings → API. The publishable key is safe for the
# browser; never put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Used to build absolute OAuth/email redirect URLs (e.g. /auth/callback).
NEXT_PUBLIC_APP_URL=http://localhost:3000
